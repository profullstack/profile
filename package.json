{
  "name": "@profullstack/profile",
  "version": "0.1.4",
  "type": "module",
  "description": "One user profile for every property: email, first_name, last_name, company_domain, job_title, linkedin_url. Validation, signup form fields, storage on Postgres/Turso/Supabase, HTTP handlers, CSV export, CLI and MCP.",
  "keywords": [
    "profile",
    "signup",
    "user-profile",
    "lead",
    "postgres",
    "turso",
    "libsql",
    "supabase",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/profile.git"
  },
  "homepage": "https://github.com/profullstack/profile#readme",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./src/react.js",
      "default": "./src/react.js"
    },
    "./cli": {
      "import": "./src/cli.js",
      "default": "./src/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "profile": "./src/cli.js"
  },
  "files": [
    "src",
    "index.d.ts",
    "react.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.6.0",
    "postgres": "^3.4.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@libsql/client": "^0.15.15",
    "@profullstack/libsql-pg": "^0.1.4",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
